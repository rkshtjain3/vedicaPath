{
  "name": "vedic-astrology-numerology-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "kill-port 3000 && pnpm --filter web dev",
    "build": "pnpm --filter \"@vedica/*\" build && pnpm --filter web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:validation": "vitest run validation/tests/jhora-benchmark.test.ts validation/tests/dasha-benchmark.test.ts validation/tests/transit-benchmark.test.ts",
    "test:regression": "vitest run validation/tests/interpretation-safety.test.ts validation/tests/regression-snapshot.test.ts",
    "test:e2e": "pnpm --filter web test:e2e",
    "validate": "pnpm test && pnpm test:validation && pnpm test:regression && pnpm test:e2e && pnpm --filter web build"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
